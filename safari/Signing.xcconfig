// Code signing for both targets.
//
// As committed: ad-hoc "Sign to Run Locally" (no Apple Developer team). Safari then loads the
// extension only with Develop → Allow Unsigned Extensions, which resets when Safari quits.
//
// To sign with your team, either run `KEEPSAKE_TEAM=ABCDE12345 safari/build.sh` (it overrides
// these settings), or put your 10-character Team ID below and switch the other two lines to
// CODE_SIGN_STYLE = Automatic and CODE_SIGN_IDENTITY = Apple Development.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
